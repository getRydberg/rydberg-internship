# Name-based tracking is the default; dashboard authentication is optional.
INTERNSHIP_AUTH_MODE=name
INTERNSHIP_HOST=dashboard.rydberg.app
INTERNSHIP_PUBLIC_ORIGIN=https://dashboard.rydberg.app
INTERNSHIP_AUTH_URL=http://backend-dashboard:8080/auth/me
INTERNSHIP_LOGIN_URL=/auth/login
INTERNSHIP_CRAWL_SECONDS=3600
INTERNSHIP_DIGEST_HOUR=18
# Both summer and off-season sources are enabled.
INTERNSHIP_SOURCES=["https://raw.githubusercontent.com/SimplifyJobs/Summer2027-Internships/dev/README.md","https://raw.githubusercontent.com/SimplifyJobs/Summer2027-Internships/dev/README-Off-Season.md"]
